<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="playbook-studio.exe"
        Arguments=""
        InstallLocation="C:\Program Files\Revi\Playbook Studio">
    </Installer>
    <PackageInformation
        PackageName="Playbook Studio"
        PackageDisplayName="Playbook Studio"
        PublisherName="CN=Revi"
        PublisherDisplayName="Revi"
        Version="0.1.0.0"
        PackageDescription="Playbook (.apbx) workflow editor">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="cc.revi.playbookstudio"
                Description="Playbook (.apbx) workflow editor"
                DisplayName="Playbook Studio"
                ExecutableName="playbook-studio.exe"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>Playbook Studio</DisplayName>
            <PublisherDisplayName>Revi</PublisherDisplayName>
            <Description>Playbook (.apbx) workflow editor</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="playbook-studio.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
